    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:setup-triggers": "node prisma/setup-triggers.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
