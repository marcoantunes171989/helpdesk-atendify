{
  "name": "helpdesk-backend",
  "version": "1.0.0",
  "description": "Helpdesk API - Backend",
  "main": "src/app.js",
  "scripts": {
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "prisma:migrate": "npx prisma migrate dev",
